import ChessProof

/-!
`lake exe flatten > ChessProof/GothamKernel.lean`

Turns the Gotham certificates into one small theorem per tree node. Every position is
materialized as a literal, so each `decide +kernel` evaluates exactly one move generation;
the kernel never holds the whole tree at once (the monolithic `check` exhausted memory).
-/
open ChessProof

structure St where
  lines : Array String := #[]
  posNames : List (Pos × String) := []
  thms : List ((Pos × Side × Nat) × String) := []
  next : Nat := 0

abbrev M := StateM St

def sideLit : Side → String
  | .white => ".white"
  | .black => ".black"

def moveLit (m : Move) : String := s!"(⟨{m.src}, {m.dst}, {m.promo}⟩ : Move)"

def emit (s : String) : M Unit := modify fun st => { st with lines := st.lines.push s }

def fresh (pre : String) : M String := do
  let st ← get
  set { st with next := st.next + 1 }
  return s!"{pre}{st.next}"

def posName (p : Pos) : M String := do
  if let some n := (← get).posNames.lookup p then return n
  let n ← fresh "p"
  emit s!"def {n} : Pos := ⟨{p.bd}, {sideLit p.turn}, {p.castle}, {p.ep}⟩"
  modify fun st => { st with posNames := (p, n) :: st.posNames }
  return n

/-- Emits a theorem `WinsIn a n p` (children first) and returns its name. -/
partial def node (a : Side) (n : Nat) (p : Pos) (c : Cert) : M String := do
  if let some t := (← get).thms.lookup (p, a, n) then return t
  let P ← posName p
  let thm ← match c with
    | .mate => do
      let t ← fresh "w"
      emit s!"theorem {t} : WinsIn {sideLit a} {n} {P} :=\n  WinsIn.mate (by decide +kernel) (by decide +kernel)"
      pure t
    | .att m k => do
      let q := play p m
      let child ← node a (n - 1) q k
      let Q ← posName q
      let t ← fresh "w"
      let mv := moveLit m
      emit s!"theorem {t} : WinsIn {sideLit a} {n} {P} :=\n  WinsIn.att {mv} (by decide +kernel)\n    (memB_sound (by decide +kernel : memB {mv} (legal {P}) = true))\n    (of_play_eq (by decide +kernel : play {P} {mv} = {Q}) {child})"
      pure t
    | .dfd rs => do
      let ms := legal p
      let mut parts : Array String := #[]
      for m in ms do
        let some k := lookup m rs | panic! "certificate misses a defender reply"
        let q := play p m
        let child ← node a n q k
        let Q ← posName q
        parts := parts.push s!"all_cons (of_play_eq (by decide +kernel : play {P} {moveLit m} = {Q}) {child})"
      let t ← fresh "w"
      let lst := ", ".intercalate (ms.map moveLit)
      emit <| s!"theorem {t} : WinsIn {sideLit a} {n} {P} := by\n  have hl : legal {P} = [{lst}] := by decide +kernel\n  refine WinsIn.dfd (by decide +kernel) (by rw [hl]; exact List.cons_ne_nil _ _) ?_\n  rw [hl]\n  exact " ++ " <|\n    ".intercalate parts.toList ++ " <|\n    all_nil"
      pure t
  modify fun st => { st with thms := ((p, a, n), thm) :: st.thms }
  return thm

/-- Number of attacker moves along the longest line of a certificate. -/
partial def ChessProof.Cert.depth : Cert → Nat
  | .mate => 0
  | .att _ k => k.depth + 1
  | .dfd rs => rs.foldl (fun acc (_, c) => max acc c.depth) 0

def program : M Unit := do
  emit "import ChessProof.Gotham\n\n/-! Generated by `lake exe flatten`. Kernel-only proofs, one per certificate node. -/\nnamespace ChessProof.GothamKernel\nopen ChessProof\n"
  let p0 := gotham
  let P0 ← posName p0
  let best := gotham_move
  let wBest ← node .black 10 (play p0 best) gotham_cert
  let QB ← posName (play p0 best)
  let mut parts : Array String := #[]
  for m in legal p0 do
    if m = best then
      parts := parts.push s!"iff_cons (iff_best (of_play_eq (by decide +kernel : play {P0} {moveLit m} = {QB}) {wBest}))"
    else
      let some c := lookup m gotham_refutations | panic! "missing refutation"
      let q := play p0 m
      let r ← node .white c.depth q c
      let Q ← posName q
      parts := parts.push s!"iff_cons (iff_refuted (of_play_eq (by decide +kernel : play {P0} {moveLit m} = {Q}) {r}) (by decide))"
  let lst := ", ".intercalate ((legal p0).map moveLit)
  emit s!"theorem gotham_eq : gotham = {P0} := by decide +kernel"
  emit s!"theorem legal_gotham : legal {P0} = [{lst}] := by decide +kernel"
  emit s!"theorem best_eq : uci \"b7b2\" = {moveLit best} := by decide +kernel"
  emit s!"/-- Kernel-checked: Black to move forces mate in 11. -/\ntheorem mate_in_11 : WinsIn .black 11 gotham := by\n  rw [gotham_eq]\n  exact WinsIn.att {moveLit best} (by decide +kernel)\n    (memB_sound (by decide +kernel : memB {moveLit best} (legal {P0}) = true))\n    (of_play_eq (by decide +kernel : play {P0} {moveLit best} = {QB}) {wBest})"
  emit <| s!"/-- Kernel-checked: `Rxb2+` is Black's only move that keeps a forced win. -/\ntheorem only_move :\n    ∀ m ∈ legal gotham, (Wins .black (play gotham m) ↔ m = uci \"b7b2\") := by\n  rw [gotham_eq, legal_gotham, best_eq]\n  exact " ++ " <|\n    ".intercalate parts.toList ++ " <|\n    iff_nil"
  emit "end ChessProof.GothamKernel"

def main : IO Unit := do
  let ((), st) := program.run {}
  IO.println ("\n\n".intercalate st.lines.toList)
